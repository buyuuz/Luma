#pragma code_page(65001)
#include <winver.h>

// LumaMcp.exe (src/mcp/relay): the MCP server AI clients start over stdio,
// which hands everything to the running Luma over a named pipe.
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINSHUN_VERSION_MAJOR,WINSHUN_VERSION_MINOR,WINSHUN_VERSION_PATCH,0
 PRODUCTVERSION WINSHUN_VERSION_MAJOR,WINSHUN_VERSION_MINOR,WINSHUN_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Luma"
            VALUE "FileDescription", "Luma MCP 服务器 · Luma MCP server"
            VALUE "FileVersion", WINSHUN_VERSION
            VALUE "InternalName", "LumaMcp"
            VALUE "OriginalFilename", "LumaMcp.exe"
            VALUE "ProductName", "Luma · Luma"
            VALUE "ProductVersion", WINSHUN_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
